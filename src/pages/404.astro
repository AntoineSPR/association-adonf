---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page introuvable | Association Adonf">
  <div class="page-container">
    <header class="page-header">
      <h1 class="main-title">
        ERREUR <span>404</span>
      </h1>
      <div class="title-underline"></div>
    </header>

    <div class="not-found-content">
      <p>La page ou le fichier que vous recherchez n'existe pas ou a été déplacé.</p>
      <a href="/" class="btn btn-primary">Retour à l'accueil</a>
    </div>
  </div>
</Layout>

<style>
  .not-found-content {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  .not-found-content p {
    font-size: 1.1rem;
    color: #555;
    max-width: 500px;
  }
</style>
